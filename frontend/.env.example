# Frontend settings. Copy to .env and fill in to switch the app from dummy data
# to the real backend. Leave them empty and the app keeps using dummy data.

# Where the Hono API runs (see backend/)
VITE_API_URL=http://localhost:4000/v1

# Supabase -> Project Settings -> API (the PUBLIC anon key, never the service role key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
