PORT=4000
# Comma-separated frontend URLs allowed to call the API.
# Paystack only redirects back to URLs listed here.
CORS_ORIGINS=http://localhost:8080

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=prepmaster-files

# Paystack (Settings -> API Keys & Webhooks). Use sk_test_... while testing.
PAYSTACK_SECRET_KEY=
